{
  "name": "dsh-telegram-notify",
  "version": "0.1.0",
  "description": "Push DSH turn, error, question, plan-review, and approval events to a Telegram chat. One-way notifications, no bot chat.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.js && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "telegram",
    "notifications"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      },
      "dsh": "^0.2.1-rc.2"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.4 || ~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
